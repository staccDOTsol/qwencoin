+/** floor(a * num / den), exactly, without forming a * num. Near this chain's proof-of-work limit
+ *  (2^248) that product does not fit in 256 bits: Bitcoin's `a *= num; a /= den;` would wrap and
+ *  retarget to garbage. With a = q * den + r the result is q * num + floor(r * num / den). That is
+ *  the same number as Bitcoin's wherever Bitcoin's is defined, and it needs only num <= 4 * den
+ *  and 4 * powLimit < 2^256 (checked by pow_tests for every chain). */
+static arith_uint256 MulDiv(const arith_uint256& a, int64_t num, int64_t den)
+{
+    const arith_uint256 bn_num{static_cast<uint64_t>(num)};
+    const arith_uint256 bn_den{static_cast<uint64_t>(den)};
+    const arith_uint256 q{a / bn_den};
+    const arith_uint256 r{a - q * bn_den};
+    return q * bn_num + (r * bn_num) / bn_den;
+}
