diff --git a/Cargo.toml b/Cargo.toml
index 29a7491..3e61766 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -120,3 +120,10 @@ doctest = false
 [[test]]
 name = "integration"
 path = "tests/lib.rs"
+
+# Qwencoin: the SHA-256 of rust-bitcoin (bitcoin_hashes) and of the bundled libsecp256k1
+# (secp256k1-sys) runs in the compiled model. upstream/rust holds those two crates with
+# patches/*-qsha.patch applied, and qsha-sys, the executor (tools/build.sh ord sets it up).
+[patch.crates-io]
+bitcoin_hashes = { path = "../rust/bitcoin_hashes" }
+secp256k1-sys = { path = "../rust/secp256k1-sys" }
