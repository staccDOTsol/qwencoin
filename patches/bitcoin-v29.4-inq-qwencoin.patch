+/* Qwencoin keeps Bitcoin's retarget rule but computes it without the 256-bit overflow that its
+ * much higher proof-of-work limit would cause (pow.cpp: MulDiv). Under Bitcoin's own limit the
+ * result has to be unchanged: the four vectors from Bitcoin's history below run on these. */
+static Consensus::Params BitcoinRetargetParams(const ArgsManager& args)
+{
+    Consensus::Params p{CreateChainParams(args, ChainType::MAIN)->GetConsensus()};
+    p.powLimit = uint256{"00000000ffffffffffffffffffffffffffffffffffffffffffffffffffffffff"};
+    p.enforce_BIP94 = false;
+    return p;
+}
+
+/* One retarget period of this chain: 2016 linked indexes (BIP94 reads the period's first block). */
+struct Period {
+    std::vector<CBlockIndex> blocks;
+    Period(int first_height, uint32_t bits, int64_t timespan) : blocks(2016)
+    {
+        for (int i = 0; i < 2016; i++) {
+            blocks[i].pprev = i ? &blocks[i - 1] : nullptr;
+            blocks[i].nHeight = first_height + i;
+            blocks[i].nBits = bits;
+            blocks[i].nTime = 1794460000 + (i == 2015 ? timespan : 0);
+        }
+    }
+    unsigned int Next(const Consensus::Params& params) const
+    {
+        return CalculateNextWorkRequired(&blocks.back(), blocks.front().GetBlockTime(), params);
+    }
+};
+
+/* The chain starts at its limit (0x2000ffff, target 2^248) and its first blocks come fast. The
+ * next target is a quarter of the limit. Bitcoin's arithmetic wraps here (2^248 * 302400 does not
+ * fit in 256 bits) and would give 0x1e0337ae: 20,000 times the work instead of 4 times. */
+BOOST_AUTO_TEST_CASE(get_next_work_qwencoin_limit)
+{
+    const auto consensus = CreateChainParams(*m_node.args, ChainType::MAIN)->GetConsensus();
+    BOOST_CHECK_EQUAL(UintToArith256(consensus.powLimit).GetCompact(), 0x2000ffffU);
+    const int64_t T{consensus.nPowTargetTimespan};
+
+    BOOST_CHECK_EQUAL(Period(0, 0x2000ffff, 5000).Next(consensus), 0x1f3fffc0U);    // fast: limit / 4
+    BOOST_CHECK_EQUAL(Period(0, 0x2000ffff, T / 4).Next(consensus), 0x1f3fffc0U);
+    BOOST_CHECK_EQUAL(Period(0, 0x2000ffff, T).Next(consensus), 0x2000ffffU);       // on schedule
+    BOOST_CHECK_EQUAL(Period(0, 0x2000ffff, 5 * T).Next(consensus), 0x2000ffffU);   // slow: capped at the limit
+    BOOST_CHECK_EQUAL(Period(0, 0x2000ffff, 1000000).Next(consensus), 0x2000d3a3U);
+    BOOST_CHECK_EQUAL(Period(2016, 0x1f3fffc0, 1000000).Next(consensus), 0x1f34e8c4U);
+    BOOST_CHECK_EQUAL(Period(2016, 0x1f3fffc0, 4 * T).Next(consensus), 0x2000ffffU); // back up to the limit
+    BOOST_CHECK_EQUAL(Period(4032, 0x1e0ffff0, 1000007).Next(consensus), 0x1e0d3a37U);
+
+    BOOST_CHECK(PermittedDifficultyTransition(consensus, 2016, 0x2000ffff, 0x1f3fffc0));
+    BOOST_CHECK(!PermittedDifficultyTransition(consensus, 2016, 0x2000ffff, 0x1f3fffbf));
+    BOOST_CHECK(!PermittedDifficultyTransition(consensus, 2016, 0x2000ffff, 0x1e0337ae));
+    BOOST_CHECK(PermittedDifficultyTransition(consensus, 2016, 0x2000ffff, 0x2000ffff));
+    BOOST_CHECK(PermittedDifficultyTransition(consensus, 6048, 0x1e0ffff0, 0x1e3fffc0));
+    BOOST_CHECK(!PermittedDifficultyTransition(consensus, 6048, 0x1e0ffff0, 0x1e3fffc1));
+    BOOST_CHECK(PermittedDifficultyTransition(consensus, 6048, 0x1e0ffff0, 0x1e03fffc));
+    BOOST_CHECK(!PermittedDifficultyTransition(consensus, 6048, 0x1e0ffff0, 0x1e03fffb));
+    BOOST_CHECK(!PermittedDifficultyTransition(consensus, 6047, 0x1e0ffff0, 0x1e03fffc)); // not a retarget height
+}
+
