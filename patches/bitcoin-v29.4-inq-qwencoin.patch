+using Header80 = std::array<unsigned char, 80>;
+
+Header80 Serialize(const CBlockHeader& h)
+{
+    Header80 b;
+    WriteLE32(b.data(), static_cast<uint32_t>(h.nVersion));
+    std::memcpy(b.data() + 4, h.hashPrevBlock.data(), 32);
+    std::memcpy(b.data() + 36, h.hashMerkleRoot.data(), 32);
+    WriteLE32(b.data() + 68, h.nTime);
+    WriteLE32(b.data() + 72, h.nBits);
+    WriteLE32(b.data() + 76, h.nNonce);
+    return b;
+}
+
+uint256 SeedOf(const Header80& b)
+{
+    static const unsigned char zero_nonce[4]{};
+    uint256 seed;
+    CHash256().Write({b.data(), 76}).Write(zero_nonce).Finalize(seed);
+    return seed;
+}
