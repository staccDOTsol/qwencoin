+/** The values of the headers seen last. A header is checked several times on its way into the
+ *  chain (as a header, as a block, when connected); the pass is worth doing once. Keyed by the
+ *  header's own 80 bytes under a salted SipHash, so a lookup costs no SHA-256. */
+struct HeaderHasher {
+    uint64_t k0, k1;
+    HeaderHasher() : k0{FastRandomContext().rand64()}, k1{FastRandomContext().rand64()} {}
+    size_t operator()(const Header80& b) const { return CSipHasher(k0, k1).Write(b).Finalize(); }
+};
+struct Cache {
+    static constexpr size_t ENTRIES{1 << 16};
+    Mutex mutex;
+    std::unordered_map<Header80, uint256, HeaderHasher> map GUARDED_BY(mutex);
+    std::deque<Header80> order GUARDED_BY(mutex);
+
+    bool Get(const Header80& b, uint256& value) EXCLUSIVE_LOCKS_REQUIRED(!mutex)
+    {
+        LOCK(mutex);
+        const auto it{map.find(b)};
+        if (it == map.end()) return false;
+        value = it->second;
+        return true;
+    }
+    void Put(const Header80& b, const uint256& value) EXCLUSIVE_LOCKS_REQUIRED(!mutex)
+    {
+        LOCK(mutex);
+        if (!map.emplace(b, value).second) return;
+        order.push_back(b);
+        if (order.size() > ENTRIES) {
+            map.erase(order.front());
+            order.pop_front();
+        }
+    }
+    void Clear() EXCLUSIVE_LOCKS_REQUIRED(!mutex)
+    {
+        LOCK(mutex);
+        map.clear();
+        order.clear();
+    }
+};
+Cache& TheCache()
+{
+    static Cache cache;
+    return cache;
+}
+} // namespace
+
+std::string Load(const std::string& path, uint64_t expected_checksum)
+{
+    Unload();
+    qwork_table t;
+    const int rc{qwork_open(path.c_str(), &t)};
+    if (rc == -1) return strprintf("The work table %s cannot be opened", path);
+    if (rc != 0) return strprintf("%s is not a work table (QWRK1, 24 layers of 3584 x 1024)", path);
+    if (t.layers != 24 || t.n != 1024 || t.m != 3584) {
+        const std::string found{strprintf("%d layers of %d x %d", t.layers, t.m, t.n)};
+        qwork_close(&t);
+        return strprintf("%s holds %s, this chain's work table is 24 layers of 3584 x 1024", path, found);
+    }
+    if (t.fnv != expected_checksum) {
+        const uint64_t got{t.fnv};
+        qwork_close(&t);
+        return strprintf("The work table %s has checksum %016x, this chain's is %016x", path, got, expected_checksum);
+    }
+    g_table = t;
+    g_loaded = true;
+    return {};
+}
+
+void Unload()
+{
+    if (g_loaded.exchange(false)) qwork_close(&g_table);
+    TheCache().Clear();
+}
+
+bool Loaded() { return g_loaded; }
+uint64_t Passes() { return g_passes; }
+
+uint256 Seed(const CBlockHeader& header) { return SeedOf(Serialize(header)); }
+
+uint256 Value(const uint256& seed, uint32_t nonce)
+{
+    Assert(g_loaded);
+    unsigned char out[32];
+    qwork_eval(&g_table, seed.data(), nonce, out);
+    ++g_passes;
+    for (int i = 0; i < 32; ++i) out[i] ^= seed.data()[i];
+    uint256 value;
+    CSHA256().Write(out, 32).Finalize(value.data());
+    return value;
+}
+
+uint256 PoWHash(const CBlockHeader& header)
+{
+    const Header80 b{Serialize(header)};
+    uint256 value;
+    if (TheCache().Get(b, value)) return value;
+    value = Value(SeedOf(b), header.nNonce);
+    TheCache().Put(b, value);
+    return value;
+}
+} // namespace qwork
